{
  "name": "@talent-ai/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed API Gateway client for the talent.ai portals",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@talent-ai/shared-types": "workspace:*",
    "axios": "^1.15.2"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
