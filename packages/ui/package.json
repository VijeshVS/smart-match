{
  "name": "@talent-ai/ui",
  "version": "0.1.0",
  "private": true,
  "description": "talent.ai brand tokens, Tailwind preset and shared design assets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tailwind-preset": "./tailwind-preset.js",
    "./brand/*": "./assets/brand/*"
  },
  "files": ["dist", "tailwind-preset.js", "assets"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@talent-ai/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
