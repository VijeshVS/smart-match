{
  "name": "@talent-ai/event-bus",
  "version": "0.1.0",
  "private": true,
  "description": "RabbitMQ publisher/consumer with reconnects, confirms, DLQ and typed domain events",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@talent-ai/logger": "workspace:*",
    "@talent-ai/shared-types": "workspace:*",
    "amqplib": "^0.10.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
