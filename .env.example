# talent.ai Platform Environment
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# ── API Gateway ─────────────────────────────────────────
API_GATEWAY_PORT=8080

# ── Datastores ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/talent_ai
POSTGRES_URL=postgresql://talent:talent@localhost:5432/talent_auth
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# ── Messaging ───────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=talent.events.topic

# ── Auth ────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── AI providers ────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Frontends ───────────────────────────────────────────
VITE_APP_NAME="talent.ai"
VITE_SITE_URL="https://talent.ai"
VITE_API_GATEWAY_URL="http://localhost:8080"
