# talent.ai Platform Environment
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
LOG_LEVEL=debug

# ── API Gateway ─────────────────────────────────────────
API_GATEWAY_PORT=8080
API_GATEWAY_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false

# Downstream service targets (used by services/api-gateway)
AUTH_SERVICE_URL=http://localhost:5001
TALENT_SERVICE_PORT=5002
TALENT_SERVICE_URL=http://localhost:5002
RECRUITER_SERVICE_PORT=5003
RECRUITER_SERVICE_URL=http://localhost:5003
ENGAGEMENT_SERVICE_PORT=5004
ENGAGEMENT_SERVICE_URL=http://localhost:5004
REWARDS_SERVICE_PORT=5005
REWARDS_SERVICE_URL=http://localhost:5005
AI_MATCHING_SERVICE_PORT=5006
AI_MATCHING_SERVICE_URL=http://localhost:5006
NOTIFICATION_SERVICE_PORT=5007
NOTIFICATION_SERVICE_URL=http://localhost:5007
ANALYTICS_SERVICE_PORT=5008
ANALYTICS_SERVICE_URL=http://localhost:5008

# ── Datastores ──────────────────────────────────────────
# MongoDB runs as a single-node replica set (rs0). Host tools should connect
# directly; containerised services may use mongodb://mongodb:27017.
MONGODB_URI=mongodb://localhost:27017/talent_profiles?directConnection=true
POSTGRES_USER=talent
POSTGRES_PASSWORD=talent
POSTGRES_URL=postgresql://talent:talent@localhost:5432/talent_auth
DATABASE_URL=postgresql://talent:talent@localhost:5432/talent_auth
RECRUITER_DATABASE_URL=postgresql://talent:talent@localhost:5432/talent_recruiter
ENGAGEMENT_DATABASE_URL=postgresql://talent:talent@localhost:5432/talent_engagement
REWARDS_DATABASE_URL=postgresql://talent:talent@localhost:5432/talent_rewards
ANALYTICS_DATABASE_URL=postgresql://talent:talent@localhost:5432/talent_analytics?schema=public
NOTIFICATION_MONGODB_URI=mongodb://localhost:27017/talent_notif?directConnection=true
NOTIFICATION_MONGODB_DB=talent_notif
NOTIFICATION_FANOUT_CHANNEL=talent.notifications
WEBSOCKET_PATH=/ws/notifications
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=talent_profiles
QDRANT_TIMEOUT_MS=5000

# ── Messaging ───────────────────────────────────────────
RABBITMQ_URL=amqp://talent:talent@localhost:5672
RABBITMQ_USER=talent
RABBITMQ_PASSWORD=talent
RABBITMQ_EXCHANGE=talent.events.topic

# ── Auth service ────────────────────────────────────────
PORT=5001
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars-min
JWT_ISSUER=talent.ai
JWT_AUDIENCE=talent.ai
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_NAME=talent_ai_refresh
COOKIE_PATH=/api/v1/auth
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=10

# ── Gateway resilience ──────────────────────────────────
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_SENSITIVE_PER_MINUTE=5
RATE_LIMIT_FAIL_OPEN=true
PROXY_TIMEOUT_MS=10000
AI_PROXY_TIMEOUT_MS=60000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_MS=30000

# ── Notification delivery ───────────────────────────────
# With EMAIL_ENABLED=false the branded email is rendered and logged instead of
# sent, which keeps local development offline. Point SMTP_URL at MailHog to
# capture real messages.
EMAIL_ENABLED=false
EMAIL_FROM=talent.ai <no-reply@talent.ai>
# SMTP_URL=smtp://localhost:1025

# ── Local email capture (MailHog) ───────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
MAILHOG_UI_URL=http://localhost:8025

# ── AI providers ────────────────────────────────────────
# `auto` selects the first configured key, otherwise the deterministic local
# engine. Embeddings default to the local hash provider for offline development.
AI_PROVIDER=auto
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_CONCURRENCY=4
AI_MAX_RERANK=12
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_TIMEOUT_MS=30000
AI_CACHE_TTL_SECONDS=3600
AI_HIGH_AFFINITY_THRESHOLD=0.8
AI_MIN_MATCH_SCORE=0.2
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Observability ───────────────────────────────────────
# Tracing is on unless a service explicitly sets OTEL_ENABLED=false.
OTEL_ENABLED=true
# OTLP/HTTP base endpoint. The SDK appends `/v1/traces`.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JAEGER_UI_URL=http://localhost:16686
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
# Prometheus / Grafana.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Frontends ───────────────────────────────────────────
VITE_APP_NAME="talent.ai"
VITE_SITE_URL="https://talent.ai"
VITE_API_GATEWAY_URL="http://localhost:8080"
