# auth-service — copy to `.env` (or rely on the repository root `.env`).

NODE_ENV=development
PORT=5001
LOG_LEVEL=debug

# PostgreSQL — talent_auth database
DATABASE_URL=postgresql://talent:talent@localhost:5432/talent_auth

# Redis — sessions, logout denylist and future token metadata
REDIS_URL=redis://localhost:6379

# RabbitMQ — transactional outbox relay
RABBITMQ_URL=amqp://talent:talent@localhost:5672
RABBITMQ_EXCHANGE=talent.events.topic

# JWT — must match services/api-gateway
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars-min
JWT_ISSUER=talent.ai
JWT_AUDIENCE=talent.ai
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Refresh cookie
COOKIE_NAME=talent_ai_refresh
COOKIE_PATH=/api/v1/auth
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.talent.ai

# Argon2id (OWASP baseline: 19 MiB, t=2, p=1)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# CORS — comma separated portal origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Transactional outbox relay
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=10

# Set to true only behind a trusted reverse proxy / load balancer
TRUST_PROXY=false
