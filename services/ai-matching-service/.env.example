NODE_ENV=development
PORT=5006
LOG_LEVEL=debug
TRUST_PROXY=false

# Qdrant vector database and Redis response cache.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=talent_profiles
QDRANT_TIMEOUT_MS=5000
# QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379

RABBITMQ_URL=amqp://talent:talent@localhost:5672
RABBITMQ_EXCHANGE=talent.events.topic

# Access tokens are verified when the service is called directly (bypassing
# the gateway). The gateway injects identity headers after verification.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_ISSUER=talent.ai
JWT_AUDIENCE=talent.ai
TRUST_GATEWAY_HEADERS=true

# Provider selection. `auto` picks the first configured provider key and
# otherwise falls back to the deterministic local engine.
AI_PROVIDER=auto
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_CONCURRENCY=4
AI_MAX_RERANK=12
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_TIMEOUT_MS=30000
AI_CACHE_TTL_SECONDS=3600
AI_HIGH_AFFINITY_THRESHOLD=0.8
AI_MIN_MATCH_SCORE=0.2

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings are cached in Qdrant. `local` is a deterministic hash embedding
# used for development, tests and provider outages.
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
