NODE_ENV=development
PORT=5008
LOG_LEVEL=debug
TRUST_PROXY=false

# Analytics read models live in their own PostgreSQL database.
ANALYTICS_DATABASE_URL=postgresql://talent:talent@localhost:5432/talent_analytics?schema=public

RABBITMQ_URL=amqp://talent:talent@localhost:5672
RABBITMQ_EXCHANGE=talent.events.topic

# Access tokens are verified when the service is called directly (bypassing
# the gateway). The gateway injects identity headers after verification.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_ISSUER=talent.ai
JWT_AUDIENCE=talent.ai
TRUST_GATEWAY_HEADERS=true

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
