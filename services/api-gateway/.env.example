# api-gateway — copy to `.env` (or rely on the repository root `.env`).

NODE_ENV=development
API_GATEWAY_PORT=8080
LOG_LEVEL=debug

# Redis — distributed token-bucket rate limiting
REDIS_URL=redis://localhost:6379

# JWT — must match services/auth-service
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_ISSUER=talent.ai
JWT_AUDIENCE=talent.ai

# Downstream services
AUTH_SERVICE_URL=http://localhost:5001
TALENT_SERVICE_URL=http://localhost:5002
RECRUITER_SERVICE_URL=http://localhost:5003
ENGAGEMENT_SERVICE_URL=http://localhost:5004
REWARDS_SERVICE_URL=http://localhost:5005
AI_MATCHING_SERVICE_URL=http://localhost:5006
NOTIFICATION_SERVICE_URL=http://localhost:5007
ANALYTICS_SERVICE_URL=http://localhost:5008

# Rate limiting (token bucket refilled per minute)
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_SENSITIVE_PER_MINUTE=5
RATE_LIMIT_FAIL_OPEN=true

# Routing resilience
PROXY_TIMEOUT_MS=10000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_MS=30000

# CORS — comma separated portal origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Set to true only behind a trusted reverse proxy / load balancer
TRUST_PROXY=false
