NODE_ENV=development
PORT=5007
LOG_LEVEL=debug
TRUST_PROXY=false

# Notification history lives in its own MongoDB database.
NOTIFICATION_MONGODB_URI=mongodb://localhost:27017/talent_notif?directConnection=true
NOTIFICATION_MONGODB_DB=talent_notif
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

RABBITMQ_URL=amqp://talent:talent@localhost:5672
RABBITMQ_EXCHANGE=talent.events.topic

# Redis fan-out keeps live sockets connected to any replica in sync.
REDIS_URL=redis://localhost:6379
NOTIFICATION_FANOUT_CHANNEL=talent.notifications

# Access tokens are verified when the service is called directly (bypassing
# the gateway). The gateway injects identity headers after verification.
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_ISSUER=talent.ai
JWT_AUDIENCE=talent.ai
TRUST_GATEWAY_HEADERS=true

# Live in-app notifications.
WEBSOCKET_PATH=/ws/notifications

# Branded email delivery. With EMAIL_ENABLED=false (the default) messages are
# rendered and logged instead of sent, which keeps local development offline.
EMAIL_ENABLED=false
EMAIL_FROM=talent.ai <no-reply@talent.ai>
# SMTP_URL=smtp://talent:talent@localhost:1025

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
