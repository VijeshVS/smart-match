# talent-service — copy to `.env` (or rely on the repository root `.env`).

NODE_ENV=development
PORT=5002
LOG_LEVEL=debug

# MongoDB — talent profile aggregate. The infra stack runs a single-node
# replica set (`rs0`) because transactional outbox writes need transactions.
MONGODB_URI=mongodb://localhost:27017/talent_profiles?directConnection=true
MONGODB_DB=talent_profiles
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# RabbitMQ — transactional outbox relay
RABBITMQ_URL=amqp://talent:talent@localhost:5672
RABBITMQ_EXCHANGE=talent.events.topic

# Engagement service — used to exclude screened candidates from the blind queue
ENGAGEMENT_SERVICE_URL=http://localhost:5004
ENGAGEMENT_TIMEOUT_MS=3000

# JWT — must match services/auth-service and services/api-gateway
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_ISSUER=talent.ai
JWT_AUDIENCE=talent.ai
# The gateway injects x-user-* headers after verifying the JWT. Set to false
# only if every caller is forced to present a bearer token directly.
TRUST_GATEWAY_HEADERS=true

# Transactional outbox relay
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=10

# CORS — comma separated portal origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Set to true only behind a trusted reverse proxy / load balancer
TRUST_PROXY=false

OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
