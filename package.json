{
  "name": "talent-ai",
  "version": "0.1.0",
  "private": true,
  "description": "talent.ai — Intelligent Hiring & Career Acceleration at the Speed of Thought",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:apps": "turbo run dev --parallel --filter=@talent-ai/candidate-portal --filter=@talent-ai/recruiter-portal",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "rebrand:audit": "node scripts/audit-rebrand.mjs",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.infra.yml down",
    "infra:logs": "docker compose -f infrastructure/docker/docker-compose.infra.yml logs -f",
    "infra:nuke": "docker compose -f infrastructure/docker/docker-compose.infra.yml down -v",
    "obs:up": "docker compose -f infrastructure/docker/docker-compose.infra.yml up -d jaeger prometheus grafana",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:config": "docker compose --env-file .env.example config",
    "dev:services": "turbo run dev --parallel --filter=@talent-ai/auth-service --filter=@talent-ai/talent-service --filter=@talent-ai/recruiter-service --filter=@talent-ai/engagement-service --filter=@talent-ai/rewards-service --filter=@talent-ai/ai-matching-service --filter=@talent-ai/notification-service --filter=@talent-ai/analytics-service --filter=@talent-ai/api-gateway",
    "dev:ai": "pnpm --filter @talent-ai/ai-matching-service dev",
    "dev:notification": "pnpm --filter @talent-ai/notification-service dev",
    "dev:analytics": "pnpm --filter @talent-ai/analytics-service dev",
    "db:auth:generate": "pnpm --filter @talent-ai/auth-service db:generate",
    "db:auth:migrate": "pnpm --filter @talent-ai/auth-service db:migrate",
    "db:auth:deploy": "pnpm --filter @talent-ai/auth-service db:deploy",
    "db:auth:seed": "pnpm --filter @talent-ai/auth-service db:seed",
    "db:recruiter:generate": "pnpm --filter @talent-ai/recruiter-service db:generate",
    "db:recruiter:migrate": "pnpm --filter @talent-ai/recruiter-service db:migrate",
    "db:recruiter:deploy": "pnpm --filter @talent-ai/recruiter-service db:deploy",
    "db:engagement:generate": "pnpm --filter @talent-ai/engagement-service db:generate",
    "db:engagement:migrate": "pnpm --filter @talent-ai/engagement-service db:migrate",
    "db:engagement:deploy": "pnpm --filter @talent-ai/engagement-service db:deploy",
    "db:rewards:generate": "pnpm --filter @talent-ai/rewards-service db:generate",
    "db:rewards:migrate": "pnpm --filter @talent-ai/rewards-service db:migrate",
    "db:rewards:deploy": "pnpm --filter @talent-ai/rewards-service db:deploy",
    "db:analytics:generate": "pnpm --filter @talent-ai/analytics-service db:generate",
    "db:analytics:migrate": "pnpm --filter @talent-ai/analytics-service db:migrate",
    "db:analytics:deploy": "pnpm --filter @talent-ai/analytics-service db:deploy",
    "db:seed:realistic": "pnpm --filter @talent-ai/realistic-seeder seed:realistic",
    "db:seed:realistic:reset": "pnpm --filter @talent-ai/realistic-seeder seed:realistic:reset",
    "dashboards:generate": "node scripts/generate-grafana-dashboards.mjs",
    "legacy:candidate": "node candidate/backend/index.js",
    "legacy:recruiter": "node hr/backend/index.js",
    "db:migrate:seed": "node scripts/migrate-monolith-to-microservices.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "argon2",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  }
}
