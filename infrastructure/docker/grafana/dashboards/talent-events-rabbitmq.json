{
  "uid": "talent-events-rabbitmq",
  "title": "talent.ai — Domain Events & RabbitMQ",
  "description": "Event publish/consume rates, handler failures, queue depth, consumer lag, retries and dead-letter growth.",
  "tags": [
    "talent.ai",
    "phase-11",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "talent-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"talent-services\"}, env)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"talent-services\"}, env)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "talent-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"talent-services\",env=~\"$env\"}, service)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"talent-services\",env=~\"$env\"}, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "event_type",
        "label": "Event type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "talent-prometheus"
        },
        "query": {
          "query": "label_values(talent_domain_events_published_total{env=~\"$env\",service=~\"$service\"}, event_type)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(talent_domain_events_published_total{env=~\"$env\",service=~\"$service\"}, event_type)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "range",
        "label": "Rate window",
        "type": "interval",
        "query": "1m,5m,15m,1h,6h",
        "current": {
          "selected": true,
          "text": "5m",
          "value": "5m"
        },
        "auto": false,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "talent.ai observability runbooks",
      "url": "https://github.com/VijeshVS/talent.ai/tree/main/docs/runbooks",
      "type": "link",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 401,
      "type": "stat",
      "title": "Publish rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(rate(talent_domain_events_published_total{env=~\"$env\",service=~\"$service\",event_type=~\"$event_type\"}[$range]))",
          "legendFormat": "published"
        }
      ]
    },
    {
      "id": 402,
