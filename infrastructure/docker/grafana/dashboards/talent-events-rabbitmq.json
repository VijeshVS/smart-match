    {
      "id": 403,
      "type": "stat",
      "title": "Handler failure rate",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(rate(talent_domain_events_consumed_total{env=~\"$env\",service=~\"$service\",event_type=~\"$event_type\",outcome=\"failure\"}[$range])) / clamp_min(sum(rate(talent_domain_events_consumed_total{env=~\"$env\",service=~\"$service\",event_type=~\"$event_type\"}[$range])), 0.000001)",
          "legendFormat": "failed"
        }
