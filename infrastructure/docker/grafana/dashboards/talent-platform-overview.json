      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum by (status_code) (rate(http_requests_total{env=~\"$env\",service=~\"$service\",route=~\"$route\",status_code=~\"$status_code\"}[$range]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "text",
      "title": "Critical flows",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false
        },
        "content": "| Flow | Where to look |\n| :--- | :--- |\n| Candidate onboarding → profile completion → AI summary | Conversion funnels, AI/TalentLens |\n| Recruiter search → TalentLens → TalentSwipe → review | AI/TalentLens, Service health |\n| Review → TalentCredits → Level-3 unlock Saga | Rewards, notifications & analytics |\n| Domain events → notification → analytics projection | Events & RabbitMQ, Rewards, notifications & analytics |"
      }
    }
  ]
}
