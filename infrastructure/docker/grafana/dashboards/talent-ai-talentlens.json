{
  "uid": "talent-ai-talentlens",
  "title": "talent.ai — AI & TalentLens",
  "description": "TalentLens throughput, provider latency/failures, fallback behaviour, cache hit rate and circuit-breaker state.",
  "tags": [
    "talent.ai",
    "phase-11",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "talent-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"talent-services\"}, env)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"talent-services\"}, env)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "talent-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"talent-services\",env=~\"$env\"}, service)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"talent-services\",env=~\"$env\"}, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "range",
        "label": "Rate window",
        "type": "interval",
        "query": "1m,5m,15m,1h,6h",
        "current": {
          "selected": true,
          "text": "5m",
          "value": "5m"
        },
        "auto": false,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "talent.ai observability runbooks",
      "url": "https://github.com/VijeshVS/talent.ai/tree/main/docs/runbooks",
      "type": "link",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 301,
      "type": "stat",
      "title": "TalentLens searches / s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(rate(talent_ai_talent_lens_searches_total{env=~\"$env\",service=~\"$service\"}[$range]))",
          "legendFormat": "searches"
        }
      ]
    },
    {
      "id": 302,
      "type": "stat",
      "title": "Provider failure rate",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(rate(talent_ai_provider_requests_total{env=~\"$env\",service=~\"$service\",outcome=~\"error|circuit_open|unconfigured\"}[$range])) / clamp_min(sum(rate(talent_ai_provider_requests_total{env=~\"$env\",service=~\"$service\"}[$range])), 0.000001)",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 303,
      "type": "stat",
      "title": "Cache hit rate",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(rate(talent_ai_cache_requests_total{env=~\"$env\",service=~\"$service\",result=\"hit\"}[$range])) / clamp_min(sum(rate(talent_ai_cache_requests_total{env=~\"$env\",service=~\"$service\",result=~\"hit|miss\"}[$range])), 0.000001)",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 304,
      "type": "stat",
      "title": "Circuit breaker state",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "max by (breaker) (talent_ai_circuit_breaker_state{env=~\"$env\",service=~\"$service\"})",
          "legendFormat": "{{breaker}}"
        }
      ]
    },
    {
      "id": 305,
      "type": "stat",
      "title": "AI HTTP 5xx rate",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(rate(http_requests_total{env=~\"$env\",service=\"ai-matching-service\",route=~\"/api/v1/ai/.*\",status_code=~\"5..\"}[$range])) / clamp_min(sum(rate(http_requests_total{env=~\"$env\",service=\"ai-matching-service\",route=~\"/api/v1/ai/.*\"}[$range])), 0.000001)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 306,
      "type": "stat",
      "title": "p95 TalentLens latency",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{env=~\"$env\",service=\"ai-matching-service\",route=~\"/api/v1/ai/.*\"}[$range])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 307,
      "type": "timeseries",
      "title": "TalentLens latency percentiles",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{env=~\"$env\",service=\"ai-matching-service\",route=~\"/api/v1/ai/.*\"}[$range])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{env=~\"$env\",service=\"ai-matching-service\",route=~\"/api/v1/ai/.*\"}[$range])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{env=~\"$env\",service=\"ai-matching-service\",route=~\"/api/v1/ai/.*\"}[$range])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
