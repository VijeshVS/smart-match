{
  "uid": "talent-conversion-funnels",
  "title": "talent.ai — Candidate & Recruiter Conversion Funnels",
  "description": "Business funnels from the analytics read models (PostgreSQL) plus Prometheus business counters.",
  "tags": [
    "talent.ai",
    "phase-11",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "talent-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"talent-services\"}, env)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"talent-services\"}, env)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "talent-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"talent-services\",env=~\"$env\"}, service)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"talent-services\",env=~\"$env\"}, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "range",
        "label": "Rate window",
        "type": "interval",
        "query": "1m,5m,15m,1h,6h",
        "current": {
          "selected": true,
          "text": "5m",
          "value": "5m"
        },
        "auto": false,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "talent.ai observability runbooks",
      "url": "https://github.com/VijeshVS/talent.ai/tree/main/docs/runbooks",
      "type": "link",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 201,
      "type": "bargauge",
      "title": "Candidate journey funnel",
      "description": "Distinct candidates at each stage: onboarded profile, first approval, reviewed, then Level-3 unlock.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "talent-analytics-db"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "talent-analytics-db"
          },
          "rawSql": "SELECT '1. Profile created' AS stage, count(*)::float AS value\nFROM candidate_metrics WHERE profile_created_at IS NOT NULL\nUNION ALL\nSELECT '2. First approval', count(*)::float FROM candidate_metrics WHERE first_approved_at IS NOT NULL\nUNION ALL\nSELECT '3. Reviewed', count(*)::float FROM candidate_metrics WHERE total_reviews > 0\nUNION ALL\nSELECT '4. Level-3 unlocks', coalesce(sum(tier3_unlocks), 0)::float FROM funnel_aggregates",
          "format": "table"
        }
      ]
    },
    {
      "id": 202,
      "type": "bargauge",
      "title": "Recruiter journey funnel",
      "description": "Recruiters with open jobs, swipes, reviews and at least one approval.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "talent-analytics-db"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "talent-analytics-db"
          },
          "rawSql": "SELECT '1. Open jobs' AS stage, count(*)::float AS value FROM recruiter_metrics WHERE open_jobs > 0\nUNION ALL\nSELECT '2. Swiped', count(*)::float FROM (SELECT recruiter_id FROM recruiter_metrics WHERE approvals + rejections > 0) s\nUNION ALL\nSELECT '3. Reviewed', count(*)::float FROM recruiter_metrics WHERE reviews_submitted > 0\nUNION ALL\nSELECT '4. Approved', count(*)::float FROM recruiter_metrics WHERE approvals > 0",
          "format": "table"
        }
      ]
    },
    {
      "id": 203,
      "type": "stat",
      "title": "Review rate",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "talent-analytics-db"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "talent-analytics-db"
          },
          "rawSql": "SELECT CASE WHEN coalesce(sum(swipes_recorded), 0) = 0 THEN 0\n       ELSE coalesce(sum(reviews_submitted), 0)::float / sum(swipes_recorded)\n       END AS value\nFROM funnel_aggregates",
          "format": "table"
        }
      ]
    },
    {
      "id": 204,
      "type": "stat",
      "title": "Approve / reject ratio",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "talent-analytics-db"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "talent-analytics-db"
          },
          "rawSql": "SELECT CASE WHEN coalesce(sum(approvals + rejections), 0) = 0 THEN 0\n       ELSE sum(approvals)::float / sum(approvals + rejections)\n       END AS value\nFROM recruiter_metrics",
          "format": "table"
        }
      ]
    },
    {
      "id": 205,
      "type": "stat",
      "title": "TalentCredits awarded",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(increase(talent_rewards_ledger_transactions_total{env=~\"$env\",service=~\"$service\"}[$__range]))",
          "legendFormat": "credits"
        }
      ]
    },
    {
      "id": 206,
      "type": "stat",
      "title": "Unlock conversion",
      "gridPos": {
        "x": 20,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(increase(talent_rewards_saga_total{env=~\"$env\",saga=\"tier3_unlock\",outcome=\"granted\"}[$__range])) / clamp_min(sum(increase(talent_ai_talent_lens_searches_total{env=~\"$env\"}[$__range])), 0.000001)",
          "legendFormat": "unlocks / searches"
        }
      ]
    },
    {
      "id": 207,
      "type": "timeseries",
      "title": "Daily funnel volume",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "talent-analytics-db"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "talent-analytics-db"
          },
          "rawSql": "SELECT day AS time,\n       profiles_created AS \"Profiles created\",\n       swipes_recorded AS \"Swipes recorded\",\n       reviews_submitted AS \"Reviews submitted\",\n       approvals AS \"Approvals\",\n       tier3_unlocks AS \"Tier-3 unlocks\"\nFROM funnel_aggregates\nORDER BY day",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 208,
      "type": "timeseries",
      "title": "Approvals & rejections (analytics)",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "talent-analytics-db"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "talent-analytics-db"
          },
          "rawSql": "SELECT day AS time,\n       approvals AS \"Approvals\",\n       swipes_recorded - approvals AS \"Other swipe outcomes\"\nFROM funnel_aggregates\nORDER BY day",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 209,
      "type": "timeseries",
      "title": "TalentLens search outcomes",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum by (outcome) (rate(talent_ai_talent_lens_searches_total{env=~\"$env\",service=~\"$service\"}[$range]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 210,
      "type": "stat",
      "title": "Average time to first approval",
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "talent-analytics-db"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "talent-analytics-db"
          },
          "rawSql": "SELECT coalesce(avg(extract(epoch FROM (first_approved_at - profile_created_at))), 0) AS value\nFROM candidate_metrics\nWHERE first_approved_at IS NOT NULL AND profile_created_at IS NOT NULL",
          "format": "table"
        }
      ]
    },
    {
      "id": 211,
      "type": "stat",
      "title": "Notification delivery rate",
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(rate(talent_notifications_created_total{env=~\"$env\",delivery_status=\"SENT\"}[$range])) / clamp_min(sum(rate(talent_notifications_created_total{env=~\"$env\"}[$range])), 0.000001)",
          "legendFormat": "delivery"
        }
      ]
    },
    {
      "id": 212,
      "type": "stat",
      "title": "Analytics projection freshness",
      "gridPos": {
        "x": 20,
        "y": 18,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "talent-analytics-db"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "talent-analytics-db"
          },
          "rawSql": "SELECT coalesce(extract(epoch FROM (now() - max(processed_at))), 0) AS value\nFROM processed_events",
          "format": "table"
        }
      ]
    }
  ]
}
