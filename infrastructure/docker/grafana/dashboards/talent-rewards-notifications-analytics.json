            "uid": "talent-prometheus"
          },
          "expr": "sum(rate(talent_rewards_saga_total{env=~\"$env\",service=~\"$service\",saga=\"tier3_unlock\",outcome=\"granted\"}[$range]))",
          "legendFormat": "granted"
        }
      ]
    },
    {
      "id": 503,
      "type": "stat",
      "title": "Rewards 5xx rate",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(rate(http_requests_total{env=~\"$env\",service=\"rewards-service\",status_code=~\"5..\"}[$range])) / clamp_min(sum(rate(http_requests_total{env=~\"$env\",service=\"rewards-service\"}[$range])), 0.000001)",
          "legendFormat": "5xx"
        }
      ]
    },
