{
  "uid": "talent-rewards-notifications-analytics",
  "title": "talent.ai — Rewards, Notifications & Analytics Health",
  "description": "TalentCredits ledger activity, Saga outcomes, notification/email delivery and analytics projection freshness.",
  "tags": [
    "talent.ai",
    "phase-11",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "talent-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"talent-services\"}, env)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"talent-services\"}, env)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "talent-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"talent-services\",env=~\"$env\"}, service)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"talent-services\",env=~\"$env\"}, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "range",
        "label": "Rate window",
        "type": "interval",
        "query": "1m,5m,15m,1h,6h",
        "current": {
          "selected": true,
          "text": "5m",
          "value": "5m"
        },
        "auto": false,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "talent.ai observability runbooks",
      "url": "https://github.com/VijeshVS/talent.ai/tree/main/docs/runbooks",
      "type": "link",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 501,
      "type": "stat",
      "title": "Credits awarded / s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "talent-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "talent-prometheus"
          },
          "expr": "sum(rate(talent_rewards_ledger_transactions_total{env=~\"$env\",service=~\"$service\",type=\"CREDIT_REVIEW_FEEDBACK\"}[$range]))",
          "legendFormat": "review credits"
        }
      ]
    },
    {
      "id": 502,
      "type": "stat",
