# talent.ai — Candidate Portal
VITE_APP_NAME="talent.ai"
VITE_SITE_URL="https://talent.ai"
VITE_RECRUITER_PORTAL_URL="https://recruiter.talent.ai"

# API Gateway is the only backend entry point for candidate portal traffic.
VITE_API_GATEWAY_URL="http://localhost:8080"

# Realtime notifications are consumed via @talent-ai/api-client. Point this to
# the gateway-exposed WebSocket endpoint for notifications in your environment.
VITE_NOTIFICATION_WS_URL="ws://localhost:8080/ws/notifications"
